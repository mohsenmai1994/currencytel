# Secrets belong in GitHub Settings > Secrets and variables > Actions > Secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@currencytel
BALE_BOT_TOKEN=
BALE_CHAT_ID=
RUBIKA_BOT_TOKEN=
RUBIKA_CHAT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Explicit feature flags; only Telegram is on by default in GitHub workflow
ENABLE_TELEGRAM=1
ENABLE_BALE=0
ENABLE_RUBIKA=0
ENABLE_INSTAGRAM=0
GENERATE_INSTAGRAM_CARD=1
POST_UNCHANGED=0
DRY_RUN=0
PAGE_TIMEOUT=13
PUBLIC_SITE_URL=https://USERNAME.github.io/REPOSITORY
INSTAGRAM_API_VERSION=v25.0
